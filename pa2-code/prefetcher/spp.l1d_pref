#include "cache.h"


#define IP_TRACKER_COUNT 24 // how many ips to be tracked
#define MASK_IP 0xFF // only 8 bits of ip stored
#define MAX_PATTERN_LENGTH 12 // the stride pattern's maximum length
#define NO_OF_REPEATS 3 // number of repeats after which we decide the pattern
#define TRIGGER 3 // after how many wrongs do we transition to non-uniform

class IP_TRACKER {
  public:
    // the IP we're tracking
    uint64_t ip;

    // the last address accessed by this IP
    uint64_t last_cl_addr;

    // the stride between the last two addresses accessed by this IP
    int64_t last_stride;

    uint32_t length_of_pattern;
    int64_t pattern[MAX_PATTERN_LENGTH];
    int64_t history[NO_OF_REPEATS*MAX_PATTERN_LENGTH];
    uint32_t history_index;
    uint32_t predicted_stride_index;

    // use LRU to evict old IP trackers
    uint32_t lru;

    // for pattern matching
    uint8_t isUniform;
    uint8_t patternFound;
    uint32_t num_fails;

    IP_TRACKER () {
        ip = 0;
        last_cl_addr = 0;
        last_stride = 0;
        length_of_pattern = 0;
        for (int i = 0; i < MAX_PATTERN_LENGTH; i+=1){
            pattern[i] = 0;
        }
        predicted_stride_index = 0;
        for (int i = 0; i < NO_OF_REPEATS*MAX_PATTERN_LENGTH; i+=1){
            history[i] = 0;
        }
        history_index = 0;
        lru = 0;
        isUniform = 1;
        patternFound = 0;
        num_fails = 0;
    };
};

IP_TRACKER trackers[IP_TRACKER_COUNT];
uint64_t PREFETCH_DEGREE = 3; // new prefetch reqsts

void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
	cout << "CPU " << cpu << " Stride pattern prefetcher" << endl;
	for (int i=0; i<IP_TRACKER_COUNT; i++)
        	trackers[i].lru = i;

}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    if (this->pf_lower_level > 0){
        int64_t accuracy = this->pf_useful*100/this->pf_lower_level;
        if (accuracy > 90){
            PREFETCH_DEGREE = 6;
        }
        else if (accuracy > 80){
            PREFETCH_DEGREE = 5;
        }
        else if (accuracy > 75){
            PREFETCH_DEGREE = 4;
        }
        else if (accuracy > 60){
            PREFETCH_DEGREE = 3;
        }
        else if (accuracy > 50){
            PREFETCH_DEGREE = 2;
        }
        else if (accuracy < 20){
            PREFETCH_DEGREE = 1;
        }
        else{
            PREFETCH_DEGREE = 2;
        }
    }
	// check for a tracker hit
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    ip = ip & MASK_IP;

    int index = -1;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }

    // this is a new IP that doesn't have a tracker yet, so allocate one
    if (index == IP_TRACKER_COUNT) {

        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        trackers[index].ip = ip;
        trackers[index].last_cl_addr = cl_addr;
        trackers[index].last_stride = 0;
        trackers[index].length_of_pattern = 0;
        for (int i = 0; i < MAX_PATTERN_LENGTH; i+=1){
            trackers[index].pattern[i] = 0;
        }
        trackers[index].predicted_stride_index = 0;
        for (int i = 0; i < NO_OF_REPEATS*MAX_PATTERN_LENGTH; i+=1){
            trackers[index].history[i] = 0;
        }
        trackers[index].history_index = 0;
        trackers[index].isUniform = 1;
        trackers[index].patternFound = 0;
        trackers[index].num_fails = 0;

        //cout << "[IP_STRIDE] MISS index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << endl;
	    for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;

        return; //metadata_in;
    }

	// sanity check
    // at this point we should know a matching tracker index
    if (index == -1)
        assert(0);

    // calculate the stride between the current address and the last address
    // this bit appears overly complicated because we're calculating
    // differences between unsigned address variables
    int64_t stride = 0;
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }

    //cout << "[IP_STRIDE] HIT  index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << " stride: " << stride << endl;

    // don't do anything if we somehow saw the same address twice in a row
    if (stride == 0) // last line
        return;	//metadata_in;

    // do prefetching if there's a pattern of seeing the same
    // stride more than once - uniform
    if (stride == trackers[index].last_stride && trackers[index].isUniform == 1) {
        trackers[index].num_fails = ((trackers[index].num_fails == 0)?0:(trackers[index].num_fails-1));
        // do some prefetching
        for (int i=0; i<PREFETCH_DEGREE; i++) {
            uint64_t pf_address = (cl_addr + (stride*(i+1))) << LOG2_BLOCK_SIZE;

            // only issue a prefetch if the prefetch address is in the same 4 KB page
            // as the current demand access address
            if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                break;

            // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
            if (MSHR.occupancy < (MSHR.SIZE>>1))
              prefetch_line(ip, addr, pf_address, FILL_L1, 0); // mshr < 0.5
            else
              prefetch_line(ip, addr, pf_address, FILL_L2, 0);
        }
    }
    if (stride != trackers[index].last_stride && trackers[index].isUniform == 1){
        trackers[index].num_fails += 1;
        if (trackers[index].num_fails >= TRIGGER){
            trackers[index].isUniform = 0;
            trackers[index].num_fails = 0;
        }
    }
    if (trackers[index].isUniform == 0){
        if (trackers[index].patternFound == 0 && trackers[index].history_index < NO_OF_REPEATS*MAX_PATTERN_LENGTH){
            trackers[index].history[trackers[index].history_index] = stride;
            trackers[index].history_index += 1;
        }
        else if (trackers[index].patternFound == 0) {
            // check for pattern lengths <= MAX_PATTERN_LENGTH, if we found a pattern then good, else, start the index from 0 again
            for (int p_l = 1; p_l <= MAX_PATTERN_LENGTH; p_l += 1){
                // tolerate 3 fails in the pattern matching also hehe
                uint32_t fails =  0;
                for (int i = 0; i < p_l; i += 1){
                    for (int j = 0; j < NO_OF_REPEATS*MAX_PATTERN_LENGTH-p_l; j += p_l){
                        if (trackers[index].history[i+j] != trackers[index].history[i+j+p_l]){
                            fails += 1;
                            if (fails >= TRIGGER){
                                break;
                            }
                        }
                    }
                    if (fails >= TRIGGER){
                        break;
                    }
                }
                if (fails < TRIGGER){
                    // let us consider the 2nd rendition of the pattern as our signature
                    trackers[index].length_of_pattern = p_l;
                    for (int i = 0; i < p_l; i += 1){
                        trackers[index].pattern[i] = trackers[index].history[i+p_l];
                    }
                    trackers[index].patternFound = 1;
                    trackers[index].num_fails = 0;
                    trackers[index].predicted_stride_index = (trackers[index].history_index + 1)%p_l;
                    break;
                }
            }
            if (trackers[index].patternFound == 0){
                trackers[index].history_index = 0;
            }
        }
        else if (trackers[index].patternFound == 1 && stride == trackers[index].pattern[trackers[index].predicted_stride_index]){
            int sum = 0;
            for (int i=0; i<PREFETCH_DEGREE; i++) {
                uint64_t pf_address = (cl_addr + ((sum + trackers[index].pattern[(trackers[index].predicted_stride_index+i+1)%(trackers[index].length_of_pattern)]))) << LOG2_BLOCK_SIZE;
                sum += trackers[index].pattern[(trackers[index].predicted_stride_index+i+1)%(trackers[index].length_of_pattern)];
                // only issue a prefetch if the prefetch address is in the same 4 KB page
                // as the current demand access address
                if ((pf_address >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
                    break;

                // check the MSHR occupancy to decide if we're going to prefetch to the L1 or L2
                if (MSHR.occupancy < (MSHR.SIZE>>1))
                prefetch_line(ip, addr, pf_address, FILL_L1, 0); // mshr < 0.5
                else
                prefetch_line(ip, addr, pf_address, FILL_L2, 0);
            }
            trackers[index].predicted_stride_index = (trackers[index].predicted_stride_index+1)%trackers[index].length_of_pattern;
        }
        else if (trackers[index].patternFound == 1 && stride != trackers[index].pattern[trackers[index].predicted_stride_index]){
            trackers[index].num_fails += 1;
            if (trackers[index].num_fails >= TRIGGER){
                trackers[index].patternFound = 0;
                trackers[index].history_index = 0;
                trackers[index].num_fails = 0;
            }
        }
    }

    trackers[index].last_cl_addr = cl_addr;
    trackers[index].last_stride = stride;


    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;
    return; //metadata_in;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
	cout << "CPU " << cpu << " L1D PC-based stride prefetcher final stats" << endl;
	cout << "Degree: " << PREFETCH_DEGREE << endl; 
}
