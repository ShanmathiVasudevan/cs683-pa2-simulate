#include "cache.h"

#define maxRRPV 3 
#define TASK_3 1
uint32_t l2_rrpv[L2C_SET][L2C_WAY]; // don't change the config of L2C_SET etc

bool chosen[L2C_SET];
int instr_accesses = 0, instr_hits = 0, total_accesses = 0, total_hits = 0;
float threshold = 0.40;
float leader_sets = 0.05;

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize SRRIP state for L2C" << endl;

    for (int i=0; i<L2C_SET; i++) {
        if (i%(int((1/leader_sets))) == 0){
            chosen[i] = true;
        }
        else{
            chosen[i] = false;
        }
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    float ratio;
    if(2*total_accesses!=total_hits)
        ratio = ((float)(2*instr_accesses-instr_hits))/(2*total_accesses-total_hits);
    else{
        ratio = 0;
    }
    if (total_accesses >= L2C_SET/2){
        total_accesses/=2;
        total_hits/=2;
        instr_accesses/=2;
        instr_hits/=2;
    }
    // look for the maxRRPV line
    while (1)
    {
        #if TASK_3
            for (int i=0; i<L2C_WAY; i++) // prefer to evict unused prefetched lines
                if (l2_rrpv[set][i] == maxRRPV && current_set[i].prefetch) return i;
        #endif
        for (int i=0; i<L2C_WAY; i++)
            if (chosen[set] == false && ratio > threshold && l2_rrpv[set][i] == maxRRPV && !(current_set[i].instruction)) // prefer to evict data before instructions
                return i;
        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV) // if no data was found, then try to evict instructions
                return i;
        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    float ratio;
    if(2*total_accesses!=total_hits)
        ratio = ((float)(2*instr_accesses-instr_hits))/(2*total_accesses-total_hits);
    else{
        ratio = 0;
    }
    
    string TYPE_NAME;
    if (type == LOAD){
        TYPE_NAME = "LOAD";
        if (chosen[set] == true){
            total_accesses += 1;
            if (isInstruction)
                instr_accesses += 1;
        }
    }
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit){ // hit is 1 for promotion
        TYPE_NAME += "_HIT";
        if (type == LOAD){
            if (chosen[set] == true){
                total_hits += 1;
                if (isInstruction)
                    instr_hits += 1;
            }
        }
    }
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;
    #if TASK_3
        float usefulness = (pf_fill > 0)?((float)pf_useful/pf_fill):0;
        if (type == PREFETCH) {
            if (hit) return;                 // we don't promote the prefetch hit 
            l2_rrpv[set][way] = (usefulness > 0.25) ? maxRRPV-1 : maxRRPV; // insert far away if the prefetches are not useful
            return;
        }
    #endif
    if (hit && isInstruction && chosen[set] == false && ratio > threshold)
        l2_rrpv[set][way] = 0; // promote all data or instructions the same way
    else if (hit && (!isInstruction || chosen[set] == true || ratio <= threshold))
        l2_rrpv[set][way] = 0; // promote all data or instructions the same way
    else if (!hit && isInstruction && chosen[set] == false && ratio > threshold)
        l2_rrpv[set][way] = 1;  //insert instructions with RRPV = 1, giving them preference
    else
        l2_rrpv[set][way] = maxRRPV-1;  //insert others with RRPV = 2
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{

}